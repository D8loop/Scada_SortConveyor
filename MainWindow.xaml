<Window x:Class="Scada_SortConveyor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="SortConveyor-S7 SCADA" Height="768" Width="1024"
        Background="#1E1E24" Foreground="White" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Animation pièce existante -->
        <Storyboard x:Key="Anim_Avance">
            <DoubleAnimation Storyboard.TargetName="PieceGlobale" Storyboard.TargetProperty="(Canvas.Left)" From="20" To="1020" Duration="0:0:10" />
            <DoubleAnimation Storyboard.TargetName="PieceGlobale" Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:9.5" Duration="0:0:0.5" />
        </Storyboard>
        <Storyboard x:Key="Anim_Ejection">
            <DoubleAnimation Storyboard.TargetName="PieceGlobale" Storyboard.TargetProperty="(Canvas.Top)" To="-20" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="PieceGlobale" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5" />
        </Storyboard>

        <!-- Animation d'ouverture du panneau d'alarmes -->
        <Storyboard x:Key="OpenAlarmDrawer">
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AlarmDrawer" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="AlarmDrawerTranslate" 
                             Storyboard.TargetProperty="X" 
                             To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AlarmOverlay" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0.4" Duration="0:0:0.35"/>
        </Storyboard>

        <!-- Animation de fermeture du panneau d'alarmes -->
        <Storyboard x:Key="CloseAlarmDrawer">
            <DoubleAnimation Storyboard.TargetName="AlarmDrawerTranslate" 
                     Storyboard.TargetProperty="X" 
                     To="256" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AlarmOverlay" 
                     Storyboard.TargetProperty="Opacity" 
                     To="0" Duration="0:0:0.25"/>

            <!-- ✅ AJOUT : l'overlay doit disparaître complètement -->
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AlarmOverlay" 
                                   Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>

            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AlarmDrawer" 
                                   Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <!-- ========== LIGNE 0 : HEADER ========== -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- IP + Connect -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="IP Automate:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#B0B0B0"/>
                    <TextBox x:Name="TxtIpAddress" Text="192.168.0.1" Width="120" Height="25" VerticalContentAlignment="Center" Margin="0,0,10,0" Background="#2D2D30" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="BtnConnecter" Content="Connecter" Width="90" Height="28" Background="#007ACC" Foreground="White" BorderThickness="0" Margin="0,0,15,0" Cursor="Hand"/>
                    <Ellipse x:Name="LedConnexion" Width="16" Height="16" Fill="DarkRed" />
                    <TextBlock x:Name="LblStatus" Text="Hors ligne" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#B0B0B0"/>
                </StackPanel>

                <!-- Boutons Marche/Arrêt/Acquit -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,0">
                    <Button x:Name="BtnMarche" Content="MARCHE" Width="100" Height="40" Background="#2E7D32" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnArret" Content="ARRÊT" Width="100" Height="40" Background="#C62828" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnAcquittement" Content="ACQUITTEMENT" Width="120" Height="40" Background="AliceBlue" Foreground="Black" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <!-- ZONE ALARMES COMPACTE (cliquable) -->
                <Border Grid.Column="2" Background="#2B0000" CornerRadius="6" Padding="10,5" BorderBrush="#8B0000" BorderThickness="1"
                        MouseLeftButtonDown="AlarmHeaderBorder_MouseLeftButtonDown" 
                        Cursor="Hand"
                        ToolTip="Cliquez pour voir toutes les alarmes">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="ALARMES SYSTÈME :" Foreground="#FF5252" FontWeight="Bold" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock Text="▶" Foreground="#FF5252" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListBox x:Name="LstAlarmes" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                                 Foreground="Red" FontWeight="Bold" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MaxHeight="60">
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========== LIGNE 1 : SYNOPTIQUE ========== -->
        <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="8" Margin="0,0,0,15" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <TextBlock Text="SYNOPTIQUE LIGNE DE TRI" Foreground="#757575" FontSize="16" FontWeight="SemiBold" Margin="20,15,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,50,0,0">
                    <Ellipse x:Name="LedMoteur" Width="24" Height="24" Fill="#555" Stroke="#333" StrokeThickness="2"/>
                    <TextBlock Text="ÉTAT CONVOYEUR" Foreground="#E0E0E0" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                </StackPanel>

                <Canvas Width="850" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle Width="850" Height="10" Fill="#424242" Canvas.Top="120"/>
                    <Rectangle Width="850" Height="4" Fill="#616161" Canvas.Top="126"/>

                    <Border Canvas.Left="50" Canvas.Top="50" Width="140" Height="140" BorderBrush="#333" BorderThickness="2" Background="#212121" CornerRadius="4">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="ZONE DÉTECTION" Foreground="#9E9E9E" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Ellipse x:Name="LedPresence" Width="30" Height="30" Fill="#333" Stroke="#FFC107" StrokeThickness="2" Margin="0,0,0,10"/>
                            <TextBlock Text="Capteur Entrée" Foreground="#FFC107" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Canvas.Left="230" Canvas.Top="20" Width="180" Height="80" Background="#001A00" BorderBrush="#00FF00" BorderThickness="1" CornerRadius="4">
                        <StackPanel VerticalAlignment="Center" Margin="10">
                            <TextBlock Text="SCANNER TYPE" Foreground="#004D00" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtTypeDetecte" Text="EN ATTENTE" Foreground="#00FF00" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Canvas.Left="450" Canvas.Top="50" Width="140" Height="140" BorderBrush="#333" BorderThickness="2" Background="#212121" CornerRadius="4">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="TRI COURT" Foreground="#9E9E9E" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Rectangle x:Name="VoyantVerinCourt" Width="60" Height="30" Fill="#333" Stroke="#03A9F4" StrokeThickness="2" Margin="0,0,0,10" RadiusX="4" RadiusY="4"/>
                            <TextBlock Text="Vérin Actif" Foreground="#03A9F4" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Canvas.Left="650" Canvas.Top="50" Width="140" Height="140" BorderBrush="#333" BorderThickness="2" Background="#212121" CornerRadius="4">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="TRI LONG" Foreground="#9E9E9E" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Rectangle x:Name="VoyantVerinLong" Width="60" Height="30" Fill="#333" Stroke="#E53935" StrokeThickness="2" Margin="0,0,0,10" RadiusX="4" RadiusY="4"/>
                            <TextBlock Text="Vérin Actif" Foreground="#E53935" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </Border>

        <!-- ========== LIGNE 2 : GRAPHIQUES ========== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#2B2B36" CornerRadius="8" Margin="0,0,15,0">
                <lvc:PieChart Series="{Binding PiecesSeries}" LegendPosition="Right" />
            </Border>
            <Border Grid.Column="1" Background="#2B2B36" CornerRadius="8" Margin="0,0,15,0">
                <lvc:CartesianChart Series="{Binding CadenceSeries}" LegendPosition="Top"/>
            </Border>
            <Border Grid.Column="2" Background="#2B2B36" CornerRadius="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="TOTAL PIÈCES" Foreground="#9E9E9E" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtTotalPieces" Text="0" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="TAUX DE QUALITÉ" Foreground="#9E9E9E" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtTauxQualite" Text="0.0 %" Foreground="#00FF00" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- PANNEAU OVERLAY ALARMES (1/4 droite)       -->
        <!-- ========================================== -->

        <!-- Fond assombri optionnel (cliquable pour fermer) -->
        <Border x:Name="AlarmOverlay" Grid.RowSpan="3" Background="Black" Opacity="0" 
                Panel.ZIndex="99" Visibility="Collapsed"
                MouseLeftButtonDown="AlarmOverlay_MouseLeftButtonDown"/>

        <!-- Drawer des alarmes -->
        <Border x:Name="AlarmDrawer" Grid.RowSpan="3"
                HorizontalAlignment="Right" Width="256" 
                Background="#140505"
                BorderBrush="#8B0000" BorderThickness="2,0,0,0"
                Panel.ZIndex="100"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="AlarmDrawerTranslate" X="256"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="8" BlurRadius="15" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header du drawer -->
                <Border Grid.Row="0" Background="#2B0000" BorderBrush="#8B0000" BorderThickness="0,0,0,1" Padding="15,12">
                    <Grid>
                        <TextBlock Text="DÉFAUTS &amp; ALARMES" 
                                   Foreground="#FF5252" FontWeight="Bold" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕" Width="28" Height="28" 
                                Background="Transparent" Foreground="#FF5252" 
                                BorderThickness="0" FontSize="14" FontWeight="Bold"
                                HorizontalAlignment="Right" Cursor="Hand"
                                Click="CloseAlarmDrawer_Click"/>
                    </Grid>
                </Border>

                <!-- ListBox agrandie -->
                <ListBox x:Name="LstAlarmesDetail" Grid.Row="1" 
                         Background="Transparent" BorderThickness="0"
                         Foreground="#FF8A80" FontSize="13" FontWeight="SemiBold"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Margin="10">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderBrush" Value="#330000"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2B0000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#1A0505" Padding="10" BorderBrush="#330000" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TxtAlarmCount" Text="0 alarme(s) active(s)" 
                               Foreground="#B0B0B0" FontSize="11" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>